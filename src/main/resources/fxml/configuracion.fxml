<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fx:id="raiz" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="pe.mathnova.presentation.controller.ConfiguracionController"
            fitToWidth="true" hbarPolicy="NEVER" focusTraversable="false" styleClass="contenido-scroll">
    <VBox spacing="18" styleClass="pantalla-configuracion">
        <padding>
            <Insets top="28" right="32" bottom="32" left="32"/>
        </padding>

        <VBox spacing="4">
            <Label text="Configuración" styleClass="titulo-pantalla"/>
            <Label text="Los cambios se guardan solos y se aplican en toda la app." styleClass="subtitulo-pantalla"
                   wrapText="true"/>
        </VBox>

        <VBox styleClass="tarjeta, ajustes-tarjeta" maxWidth="760">
            <Label text="Resolución" styleClass="titulo-tarjeta"/>

            <HBox styleClass="ajuste-fila">
                <VBox styleClass="ajuste-texto" HBox.hgrow="ALWAYS">
                    <Label text="Campo por defecto" styleClass="ajuste-nombre"/>
                    <Label text="Con qué campo empieza Resolver. Q es el de siempre (RN27)."
                           styleClass="subtitulo-tarjeta" wrapText="true"/>
                </VBox>
                <HBox styleClass="selector-campo" minWidth="-Infinity">
                    <ToggleButton fx:id="campoQ" text="Q" styleClass="opcion-campo" accessibleText="Campo Q"/>
                    <ToggleButton fx:id="campoR" text="R" styleClass="opcion-campo" accessibleText="Campo R"/>
                    <ToggleButton fx:id="campoC" text="C" styleClass="opcion-campo" accessibleText="Campo C"/>
                </HBox>
            </HBox>

            <HBox styleClass="ajuste-fila">
                <VBox styleClass="ajuste-texto" HBox.hgrow="ALWAYS">
                    <Label text="Cómo se abre la pizarra" styleClass="ajuste-nombre"/>
                    <Label text="Con todos los pasos a la vista, o de uno en uno." styleClass="subtitulo-tarjeta"
                           wrapText="true"/>
                </VBox>
                <HBox styleClass="selector-campo" minWidth="-Infinity">
                    <ToggleButton fx:id="modoTodos" text="Todos los pasos" styleClass="opcion-campo, opcion-ancha"/>
                    <ToggleButton fx:id="modoPaso" text="Paso a paso" styleClass="opcion-campo, opcion-ancha"/>
                </HBox>
            </HBox>

            <HBox styleClass="ajuste-fila">
                <VBox styleClass="ajuste-texto" HBox.hgrow="ALWAYS">
                    <Label text="Mostrar explicaciones" styleClass="ajuste-nombre"/>
                    <Label text="Las notas al costado de cada paso: por qué aplica el método."
                           styleClass="subtitulo-tarjeta" wrapText="true"/>
                </VBox>
                <ToggleButton fx:id="mostrarExplicaciones" styleClass="interruptor-explicaciones"
                              accessibleText="Mostrar explicaciones" minWidth="-Infinity">
                    <graphic>
                        <StackPane styleClass="interruptor-riel">
                            <Region styleClass="interruptor-perilla"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>

            <HBox styleClass="ajuste-fila">
                <VBox styleClass="ajuste-texto" HBox.hgrow="ALWAYS">
                    <Label text="Mostrar códigos de técnica" styleClass="ajuste-nombre"/>
                    <Label text="Encendido, la pizarra muestra «F16 · Ruffini»." styleClass="subtitulo-tarjeta"
                           wrapText="true"/>
                </VBox>
                <ToggleButton fx:id="mostrarCodigos" styleClass="interruptor-explicaciones"
                              accessibleText="Mostrar códigos de técnica" minWidth="-Infinity">
                    <graphic>
                        <StackPane styleClass="interruptor-riel">
                            <Region styleClass="interruptor-perilla"/>
                        </StackPane>
                    </graphic>
                </ToggleButton>
            </HBox>
        </VBox>

        <VBox styleClass="tarjeta, ajustes-tarjeta" maxWidth="760">
            <Label text="Apariencia" styleClass="titulo-tarjeta"/>

            <HBox styleClass="ajuste-fila">
                <VBox styleClass="ajuste-texto" HBox.hgrow="ALWAYS">
                    <Label text="Tamaño de letra de la pizarra" styleClass="ajuste-nombre"/>
                    <Label text="También en la hoja del Historial, en Práctica y en el PDF."
                           styleClass="subtitulo-tarjeta" wrapText="true"/>
                </VBox>
                <HBox styleClass="selector-campo" minWidth="-Infinity">
                    <ToggleButton fx:id="letraNormal" text="Normal" styleClass="opcion-campo, opcion-ancha"/>
                    <ToggleButton fx:id="letraGrande" text="Grande" styleClass="opcion-campo, opcion-ancha"/>
                    <ToggleButton fx:id="letraMuyGrande" text="Muy grande" styleClass="opcion-campo, opcion-ancha"/>
                </HBox>
            </HBox>
            <StackPane fx:id="vistaPrevia" styleClass="ajuste-vista-previa, escala-letra" alignment="CENTER_LEFT"
                       accessibleText="Vista previa del tamaño de letra"/>

            <HBox styleClass="ajuste-fila">
                <VBox styleClass="ajuste-texto" HBox.hgrow="ALWAYS">
                    <Label text="Tema" styleClass="ajuste-nombre"/>
                    <Label text="En oscuro solo cambian el fondo y el texto; el azul se mantiene."
                           styleClass="subtitulo-tarjeta" wrapText="true"/>
                </VBox>
                <HBox styleClass="selector-campo" minWidth="-Infinity">
                    <ToggleButton fx:id="temaClaro" text="Claro" styleClass="opcion-campo, opcion-ancha"/>
                    <ToggleButton fx:id="temaOscuro" text="Oscuro" styleClass="opcion-campo, opcion-ancha"/>
                </HBox>
            </HBox>
        </VBox>

        <VBox styleClass="tarjeta, ajustes-tarjeta" maxWidth="760">
            <Label text="Datos" styleClass="titulo-tarjeta"/>
            <HBox styleClass="ajuste-fila">
                <Label fx:id="datos" styleClass="subtitulo-tarjeta" wrapText="true" HBox.hgrow="ALWAYS"
                       maxWidth="Infinity"/>
                <Button fx:id="borrarHistorial" text="Borrar todo el historial" styleClass="boton-secundario, boton-peligro"
                        onAction="#borrarHistorial" minWidth="-Infinity"/>
            </HBox>
        </VBox>

        <VBox styleClass="tarjeta, ajustes-tarjeta" maxWidth="760">
            <Label text="Acerca de" styleClass="titulo-tarjeta"/>
            <GridPane fx:id="versiones" hgap="24" vgap="8"/>
        </VBox>
    </VBox>
</ScrollPane>
